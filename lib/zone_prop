use strict;
use utf8;
use Encode qw(decode);
use feature 'unicode_strings';
binmode(STDOUT, ":utf8");

use File::Basename;
use Cwd 'realpath';
use lib dirname(realpath(__FILE__));
use Colors;
use Util;
use Location;

use Math::Round;
use JSON qw( decode_json );

my $username = $ENV{'USER'} || $ENV{'USERNAME'} || getpwuid($<);
# change this to 0 to always exit with success
our $exitnonzeroonerror = 1;
$exitnonzeroonerror = 0 if $username eq getEggdropUID();

my $mode = "SSB";
my $geo = undef;
my $qth = undef;

@ARGV = map { decode "utf-8", $_ } @ARGV;
# eggdrop doesn't split args on spaces
@ARGV=split(' ', join(' ',@ARGV));

my $i = 0;
while ($i <= $#ARGV) {
  if ($ARGV[$i] =~ /^--geo$/i) {
    $i++;
    $geo = $ARGV[$i];
    $i++;
    next;
  }
  if (lc($ARGV[$i]) eq "--ft8") {
    $mode = "FT8";
    $i++;
    next;
  } elsif (lc($ARGV[$i]) eq "--cw") {
    $mode = "CW";
    $i++;
    next;
  } elsif (lc($ARGV[$i]) eq "--ssb") {
    $mode = "SSB"; #redundant, SSB is default
    $i++;
    next;
  }
  if (defined($qth)) {
    $qth = $qth . " " . $ARGV[$i];
  } else {
    $qth = $ARGV[$i];
  }
  $i++;
}

if (!defined($geo) and (!defined($qth) or length($qth) == 0)) {
  if ($username eq getEggdropUID()) {
    print "usage: !zones <location|grid>\n";
  } else {
    print "usage: $0 <location|grid>\n";
  }
  exit $exitnonzeroonerror;
}

if (defined($qth)) {
  $qth =~ s/^\s*//;
  $qth =~ s/\s*$//;
  $geo = argToCoords($qth);
}

if (not defined $geo) {
  print "unknown location: $qth\n";
  exit $exitnonzeroonerror;
}

my $grid = coordToGrid(split /,/, $geo);

if (not defined $grid or $grid eq "") {
  print "Error, no place defined: $qth, $geo ?\n";
  exit $exitnonzeroonerror;
}

my $cachedir = $ENV{HOME} . "/.qrmbot/cache";
my $cachefile = $cachedir . "/zoneprop-$grid-$mode.json";
my $needProp = 0;
my $maxAge = 60 * 15; # (15 minutes)

if (not -d $cachedir) {
  print "making cache directory..\n";
  system ("mkdir -p $cachedir\n");
  if (not -d $cachedir) {
    print "unable to make cache directory $cachedir\n";
  }
}

$needProp = 1 if not -e $cachefile;

if ($needProp == 0) {
  my $now = time;
  my (undef, undef, undef, undef, undef, undef, undef, $size, undef, $mtime, undef, undef, undef) = stat $cachefile;
  if (defined $mtime) {
    my $age = $now - $mtime;
    $needProp = 1 if $age > $maxAge or $size == 0;
  } else {
    $needProp = 1;
  }
}

my %loc_map = (
  # largest city in each zone by population
  1 => "61.2181,-149.9003", # 291000 Anchorage
  2 => "50.217,-66.383", # 25000 Sept-Îles
  3 => "34.0522,-118.2437", # 17400000 Los Angeles
  4 => "41.8781,-87.6298", # 9000000 Chicago
  5 => "40.7128,-74.0060", # 19500000 New York City
  6 => "19.4326,-99.1332", # 25600000 Mexico City
  7 => "14.6349,-90.5069", # 3300000 Guatemala City
  8 => "18.4861,-69.9312", # 4400000 Santo Domingo
  9 => "4.7110,-74.0721", # 11800000 Bogotá
  10 => "-12.0464,-77.0428", # 11500000 Lima
  11 => "-23.5505,-46.6333", # 23000000 São Paulo
  12 => "-33.4489,-70.6693", # 7000000 Santiago
  13 => "-34.6037,-58.3816", # 15800000 Buenos Aires
  14 => "48.8566,2.3522", # 11300000 Paris
  15 => "45.4642,9.1900", # 4200000 Milan
  16 => "55.7558,37.6173", # 18500000 Moscow
  17 => "41.2995,69.2401", # 3100000 Tashkent
  18 => "55.0500,82.9500", # 1600000 Novosibirsk
  19 => "48.4800,135.0700", # 620000 Khabarovsk
  20 => "41.0082,28.9784", # 15800000 Istanbul
  21 => "24.8607,67.0011", # 21900000 Karachi
  22 => "23.8103,90.4125", # 36600000 Dhaka
  23 => "43.8225,87.6125", # 4000000 Ürümqi
  24 => "31.2304,121.4737", # 29600000 Shanghai
  25 => "35.6762,139.6503", # 33400000 Tokyo
  26 => "13.7563,100.5018", # 18300000 Bangkok
  27 => "14.5995,120.9842", # 24700000 Manila
  28 => "-6.2088,106.8456", # 41900000 Jakarta
  29 => "-31.9505,115.8605", # 2300000 Perth
  30 => "-33.8688,151.2093", # 5300000 Sydney
  31 => "21.3099,-157.8581", # 1000000 Honolulu
  32 => "-36.8509,174.7645", # 1700000 Auckland
  33 => "33.5731,-7.5898", # 4500000 Casablanca
  34 => "30.0444,31.2357", # 25600000 Cairo
  35 => "6.5244,3.3792", # 21900000 Lagos
  36 => "-4.4419,15.2663", # 16900000 Kinshasa
  37 => "-1.2921,36.8219", # 5600000 Nairobi
  38 => "-26.2041,28.0473", # 15100000 Johannesburg
  39 => "-18.8792,47.5079", # 3700000 Antananarivo
  40 => "64.1466,-21.9426", # 250000 Reykjavík
);

# "bw" (bandwidth) defaults to 3000 for SSB
# "snrr" (SNR required) defaults to 6 for SSB
my %mode_to_params = (
  "SSB" => {
    "bw" => 3000,
    "snrr" => 6
  },
  "FT8" => {
    "bw" => 50,
    "snrr" => -3
  },
  "CW" => {
    "bw" => 500,
    "snrr" => 0,
  }
);

my $locs = "loc=$grid";
foreach my $c (sort keys %loc_map) {
  $locs .= "&" if $locs ne "";
  $locs .= "loc=$loc_map{$c}";
}
#print $locs, "\n";

my $params = "";
foreach my $k (keys %{$mode_to_params{$mode}}) {
  my $v = $mode_to_params{$mode}{$k};
  $params .= "&" if $params ne "";
  $params .= "$k=$v";
}
#print $params, "\n";

# txgos/rxgos = "gain offset" relative to isotropic.
# So +2.16 dBi = 0 dBd (dipole with optimal azimuth).
my $continental_url = "https://prop.kc2g.com/hfprop/bestband.json?txpow=100&txgos=2.16&rxgos=2.16&hours_ahead=0&$locs&$params";
#print "$continental_url\n";

my $json = undef;

if ($needProp == 0) {
  # cache is fresh
  open(CACHE, '<', $cachefile);
  local $/;   # read entire file -- FIXME: potentially memory hungry
  $json = <CACHE>;
  close(CACHE);
} else {
  open(HTTP, '-|', "curl --stderr - --max-time 10 -s -k -L '$continental_url'");
  local $/;   # read entire file -- FIXME: potentially memory hungry
  $json = <HTTP>;
  close(HTTP);
  #print "$json\n";
  if (not $json =~ /^\s*{/) {
    print "error while retrieving data: $json\n";
    exit $exitnonzeroonerror;
  }
}
#print $json, "\n";
my $j = decode_json($json);

if ($needProp != 0) {
  open(CACHE, ">", $cachefile);
  print CACHE $json;
  close(CACHE);
}

my %json_place_to_index_map;
for(my $i = 0; $i < scalar @{$j->{locations}}; $i++) {
  my $loc = $j->{locations}[$i]{loc};
  if ($grid eq $loc) {
        $json_place_to_index_map{$grid} = $i;
  } else {
    foreach my $c (keys %loc_map) {
      if ($loc_map{$c} eq $loc) {
        $json_place_to_index_map{$c} = $i;
      }
    }
  }
}


print "Best $mode band from $grid to CQ Zones: ";
print "\n" if $username ne getEggdropUID();

my $gi = $json_place_to_index_map{$grid};
for (my $z = 1; $z <= 40; $z++) {
  my ($val, $bcr, $ind) = (undef, undef, undef);
  my $zi = $json_place_to_index_map{$z};

  print bold("$z"), ":";

  if (not defined $j->{best}[$gi][$zi]) {
    print grey("∅"); # empty set
  } else {
    $val = $j->{best}[$gi][$zi]{band};
    $bcr = $j->{best}[$gi][$zi]{bcr};
    if ($bcr >= 70.0) {
      $ind = "+";
      print green("$ind$val");
    } elsif ($bcr < 70.0 and $bcr > 30.0) {
      $ind = "";
      print yellow("$ind$val");
    } elsif ($bcr <= 30.0) {
      $ind = "-";
      print red("$ind$val");
    }
  }
  if ($username eq getEggdropUID()) {
    print "; " unless $z == 40;
  } else {
    print "\n";
  }
}
print "\n" if $username eq getEggdropUID();

exit 0;

use strict;
use warnings;

use utf8;
use Encode qw(decode);
use feature 'unicode_strings';
binmode(STDOUT, ":utf8");

use File::Basename;
use Cwd 'realpath';
use lib dirname(realpath(__FILE__));
use Colors;
use Location;
use Util;

use JSON qw( decode_json );
use Math::Round;

@ARGV = map { decode "utf-8", $_ } @ARGV;
# eggdrop doesn't split args on spaces
@ARGV=split(' ', join(' ',@ARGV));

my $username = $ENV{'USER'} || $ENV{'USERNAME'} || getpwuid($<);
# change this to 0 to always exit with success
our $exitnonzeroonerror = 1;
$exitnonzeroonerror = 0 if $username eq getEggdropUID();

my $geo = undef;
my $query = undef;

my $fuelId = 1; # TODO
my $dist = 5;
my $maxClubLookups = 4; # cap the station lookups spent skipping warehouse clubs

my $curl_impersonate = "curl-impersonate-chrome";
my $curl_impersonate_path = `which $curl_impersonate`;
chomp $curl_impersonate_path;
if ( not -e $curl_impersonate_path or not -x $curl_impersonate_path ) {
  $curl_impersonate_path = $ENV{HOME} . "/bin/$curl_impersonate";
}
if ( not -e $curl_impersonate_path or not -x $curl_impersonate_path ) {
  print("Error: unable to find $curl_impersonate\n");
  exit $exitnonzeroonerror;
}

my $i = 0;
while ($i <= $#ARGV) {
  if (!defined($geo) and $ARGV[$i] =~ /^--geo$/i) {
    $i++;
    $geo = $ARGV[$i];
    $i++;
    next;
  }
  if ($ARGV[$i] =~ /^--diesel$/i) {
    $fuelId = 4;
    $i++;
    next;
  }
  if (isNumeric($ARGV[$i]) and length($ARGV[$i]) != 5) {
    # not a zip code, must be a distance
    $dist = $ARGV[$i];
    $i++;
    next;
  }
  if (defined($query)) {
    $query = $query ." ". $ARGV[$i];
  } else {
    $query = $ARGV[$i];
  }
  $i++;
}

if (not defined $query and not defined $geo) {
  if ($username eq getEggdropUID()) {
    print "usage: !gas <grid>|<lat>,<lon>|<qth>\n";
  } else {
    print "usage: $0 <grid>|<lat>,<lon>|<qth>\n";
  }
  exit $exitnonzeroonerror;
}

my $result = argToCoords($query) if defined $query;

if (defined $query and not defined $result) {
  print "error: unable to find \"$query\"\n";
  exit $exitnonzeroonerror;
}

my ($mylat, $mylon) = split(',', $geo) if defined $geo;
($mylat, $mylon) = split(',', $result) if defined $result;

if (defined $geo and (not isNumeric($mylat) or not isNumeric($mylon))) {
  print "error: invalid --geo value\n";
  exit $exitnonzeroonerror;
}

my ($maxlat, undef) = rangeAndBearing($mylat, $mylon, $dist, 0);
my ($minlat, undef) = rangeAndBearing($mylat, $mylon, $dist, 180);
my (undef, $maxlon) = rangeAndBearing($mylat, $mylon, $dist, 90);
my (undef, $minlon) = rangeAndBearing($mylat, $mylon, $dist, 270);

my $url = "https://www.gasbuddy.com/gaspricemap/map";
my $ct = "Content-Type: application/json; charset=utf-8";
my $req = "{\"fuelTypeId\":\"$fuelId\",\"minLat\":$minlat,\"maxLat\":$maxlat,\"minLng\":$minlon,\"maxLng\":$maxlon,\"width\":2000,\"height\":2000}";

# curl 'https://www.gasbuddy.com/gaspricemap/map' --compressed -H 'Content-Type: application/json; charset=utf-8' --data-raw '{"fuelTypeId":"1","minLat":41.02367207781487,"maxLat":41.10133099662773,"minLng":-74.2389950182373,"maxLng":-74.0324863817627,"width":1203,"height":600}'
#
local $/;   # read entire file -- FIXME: potentially memory hungry
open (JSON, '-|', "curl --compressed --max-time 10 -s -k -L -H '${ct}' --data '${req}' $url");
my $json = <JSON>;
close(JSON);
if ($json =~ /(Cloudflare|challenge-error-text)/) {
  print "Error: unable to retrieve station list (Cloudflare)\n";
  exit $exitnonzeroonerror;
}
if (not $json =~ /^\s*{/) {
  print "Error: unable to retrieve station list\n";
  exit $exitnonzeroonerror;
}
my $j = decode_json($json);
#print $json, "\n";

my $stationsref = [];
my ($m, $n);

# copy primary and secondary into a single structure
for ($m = 0, $n = 0; $m < scalar (@{$j->{primaryStations}}); $m++, $n++) {
  $stationsref->[$n] = $j->{primaryStations}->[$m];
  #print "$m -> $n\n";
}
for ($m = 0; $m < scalar (@{$j->{secondaryStations}}); $m++, $n++) {
  $stationsref->[$n] = $j->{secondaryStations}->[$m];
  #print "$m -> $n\n";
}

# find cheapest and priciest prices within returned data
my ($cheapestCashPx, $cheapestCreditPx) = (9999.99, 9999.99);
my ($priciestCashPx, $priciestCreditPx) = (0, 0);
for ($n = 0; $n < scalar @{$stationsref}; $n++) {
  next if not defined $stationsref->[$n]->{price};
  next if $stationsref->[$n]->{price} eq "--";
  if ($stationsref->[$n]->{iscash}) {
    if ($stationsref->[$n]->{price} < $cheapestCashPx) {
      $cheapestCashPx = $stationsref->[$n]->{price};
    }
    if ($stationsref->[$n]->{price} > $priciestCashPx) {
      $priciestCashPx = $stationsref->[$n]->{price};
    }
  } else {
    if ($stationsref->[$n]->{price} < $cheapestCreditPx) {
      $cheapestCreditPx = $stationsref->[$n]->{price};
    }
    if ($stationsref->[$n]->{price} > $priciestCreditPx) {
      $priciestCreditPx = $stationsref->[$n]->{price};
    }
  }
}

# find nearest station at that price
my ($nearestCash, $nearestCredit);
my ($distCash, $bearingCash) = (99999.9, undef);
my ($distCredit, $bearingCredit) = (99999.9, undef);
for ($n = 0; $n < scalar @{$stationsref}; $n++) {
  next if not defined $stationsref->[$n]->{price};
  next if $stationsref->[$n]->{price} eq "--";
  if ($stationsref->[$n]->{iscash}) {
    if ($stationsref->[$n]->{price} == $cheapestCashPx) {
      my ($dist, $bearing) = distBearing($mylat, $mylon, $stationsref->[$n]->{lat}, $stationsref->[$n]->{lng});
      if ($dist < $distCash) {
	$nearestCash = $n;
	$distCash = $dist;
	$bearingCash = $bearing;
      }
    }
  } else {
    if ($stationsref->[$n]->{price} == $cheapestCreditPx) {
      my ($dist, $bearing) = distBearing($mylat, $mylon, $stationsref->[$n]->{lat}, $stationsref->[$n]->{lng});
      if ($dist < $distCredit) {
	$nearestCredit = $n;
	$distCredit = $dist;
	$bearingCredit = $bearing;
      }
    }
  }
}


# FIXME DEBUG
#print "Cash:\t$cheapestCashPx @ $nearestCash #$stationsref->[$nearestCash]->{id} $distCash km $bearingCash°\n";
#print "Credit:\t$cheapestCreditPx @ $nearestCredit #$stationsref->[$nearestCredit]->{id} $distCredit km $bearingCredit°\n";

my $cloudflareError = 0;

my $c;
$c = stationDetail($stationsref->[$nearestCash]->{id}) if defined $nearestCash;

#print "CASH: $c->{station}->{Name}, $c->{station}->{Address}, $c->{station}->{City} $c->{prices}->[0]->{Price} $c->{prices}->[0]->{Time}\n";

my $d;
$d = stationDetail($stationsref->[$nearestCredit]->{id}) if defined $nearestCredit;

#print "CREDIT: $d->{station}->{Name}, $d->{station}->{Address}, $d->{station}->{City} $d->{prices}->[0]->{Price} $d->{prices}->[0]->{Time}\n";

# these can make further station requests, so work them out before printing
# anything, to keep an error message from landing mid-line
my ($cashExtra, $creditExtra) = ("", "");
$cashExtra = otherPrices($stationsref, $nearestCash, $cheapestCashPx, $priciestCashPx, 1, $c)
  if defined $nearestCash;
$creditExtra = otherPrices($stationsref, $nearestCredit, $cheapestCreditPx, $priciestCreditPx, 0, $d)
  if defined $nearestCredit;

if (defined $nearestCash) {
  print "cash  : ", nearest(0.1, $distCash), " km ", azToNEWS($bearingCash), ": ", bold($cheapestCashPx), " at ";
  print "$c->{station}->{Name}, $c->{station}->{Address}, $c->{station}->{City} as of $c->{prices}->[0]->{Time}" if defined $c;
  print nearest(0.00001, $stationsref->[$nearestCash]->{lat}), ",", nearest(0.00001, $stationsref->[$nearestCash]->{lng}) if not defined $c;
  print $cashExtra, "\n";
}

if (defined $nearestCredit) {
  print "credit: ", nearest(0.1, $distCredit), " km ", azToNEWS($bearingCredit), ": ", bold($cheapestCreditPx), " at ";
  print "$d->{station}->{Name}, $d->{station}->{Address}, $d->{station}->{City} as of $d->{prices}->[0]->{Time}" if defined $d;
  print nearest(0.00001, $stationsref->[$nearestCredit]->{lat}), ",", nearest(0.00001, $stationsref->[$nearestCredit]->{lng}) if not defined $d;
  print $creditExtra, "\n";
}

if (not defined $nearestCash and not defined $nearestCredit) {
  print "not found\n";
}

# retrieve the details of a single station; returns undef if blocked
sub stationDetail {
  my ($id) = @_;
  my $stationUrl = "https://www.gasbuddy.com/gaspricemap/station";
  my $stationReq = "{\"id\":$id,\"fuelTypeId\":\"$fuelId\"}";

  local $/;   # read entire file -- FIXME: potentially memory hungry
  open (JSON, '-|', "$curl_impersonate_path -X POST --compressed --max-time 10 -s -k -L  -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0' -H '${ct}' --data '${stationReq}' $stationUrl");
  my $stationJson = <JSON>;
  close(JSON);
  #print $stationJson, "\n";
  if ($stationJson =~ /(Cloudflare|challenge-error-text)/) {
    print "Error: unable to retrieve station details\n" if $cloudflareError == 0;
    $cloudflareError = 1;
    return undef;
  }
  my $detail = decode_json($stationJson) or die "parse error: $stationJson\n";
  return $detail;
}

# warehouse clubs sell only to members, so their price is not one that everyone
# can actually pay.  Some of these names are written with a typographic
# apostrophe, and BJ's is sometimes just "BJs".
sub isClub {
  my ($name) = @_;
  return 0 if not defined $name;
  return $name =~ /(?: costco
                     | \bsam['\x{2019}]?s \s+ club\b
                     | \bbj['\x{2019}]?s\b
                     )/xi;
}

# cheapest station that is not a warehouse club, for the given payment type.
# Walks the stations in price order -- a club is skipped whatever its price,
# and a non-club matching the cheapest price still counts -- spending at most
# $maxClubLookups station lookups. Returns undef if there is none, or if the
# lookups were blocked.
sub nextNonClub {
  my ($stations, $lat, $lon, $skip, $iscash) = @_;

  my @candidates;
  for (my $k = 0; $k < scalar @{$stations}; $k++) {
    next if $k == $skip;
    next if not defined $stations->[$k]->{price};
    next if $stations->[$k]->{price} eq "--";
    next if ($stations->[$k]->{iscash} ? 1 : 0) != $iscash;
    my ($thisDist, $thisBearing) = distBearing($lat, $lon, $stations->[$k]->{lat}, $stations->[$k]->{lng});
    push @candidates, { idx => $k,
                        price => $stations->[$k]->{price},
                        dist => $thisDist,
                        bearing => $thisBearing };
  }
  @candidates = sort { $a->{price} <=> $b->{price} or $a->{dist} <=> $b->{dist} } @candidates;

  my $lookups = 0;
  foreach my $cand (@candidates) {
    last if $lookups >= $maxClubLookups;
    $lookups++;
    my $detail = stationDetail($stations->[$cand->{idx}]->{id});
    return undef if not defined $detail;   # blocked, no point trying the rest
    next if isClub($detail->{station}->{Name});
    $cand->{name} = $detail->{station}->{Name};
    return $cand;
  }
  return undef;
}

# trailing summary of the other prices in the area: the cheapest station open to
# non-members, when the cheapest overall is a warehouse club, followed by the
# highest price seen
sub otherPrices {
  my ($stations, $skip, $cheapest, $priciest, $iscash, $detail) = @_;
  my @parts;
  my $next;

  if (defined $detail and isClub($detail->{station}->{Name})) {
    $next = nextNonClub($stations, $mylat, $mylon, $skip, $iscash);
    push @parts, "next $next->{price} at $next->{name}, "
                 . nearest(0.1, $next->{dist}) . " km " . azToNEWS($next->{bearing})
      if defined $next;
  }

  push @parts, "high $priciest"
    if $priciest > $cheapest and (not defined $next or $priciest > $next->{price});

  return "" if not @parts;
  return " (" . join("; ", @parts) . ")";
}

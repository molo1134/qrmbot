# --- fetch ---
sub fetchJSON {
  my ($url) = @_;
  open(my $fh, '-|', "curl --max-time 10 -s -k -L -A \"$useragent\" '$url'");
  local $/;
  my $raw = <$fh>;
  close($fh);
  return undef unless defined($raw) && $raw =~ /^\s*\{/;
  return decode_json($raw);
}


use strict;
use utf8;
use feature 'unicode_strings';
binmode(STDOUT, ":utf8");

use File::Basename;
use Cwd 'realpath';
use lib dirname(realpath(__FILE__));
use Colors;
use Util;

use Math::Round;
use JSON qw( decode_json );

my $username = $ENV{'USER'} || $ENV{'USERNAME'} || getpwuid($<);
# change this to 0 to always exit with success
our $exitnonzeroonerror = 1;
$exitnonzeroonerror = 0 if $username eq getEggdropUID();

my $mode = "SSB";

# eggdrop doesn't split args on spaces
@ARGV=split(' ', join(' ',@ARGV));

my $i = 0;
while ($i <= $#ARGV) {
  if (lc($ARGV[$i]) eq "--ft8") {
    $mode = "FT8";
  } elsif (lc($ARGV[$i]) eq "--cw") {
    $mode = "CW";
  } elsif (lc($ARGV[$i]) eq "--ssb") {
    $mode = "SSB"; #redundant, SSB is default
  }
  $i++;
}

my %loc_map = (
  # continent center by population weighted average
  "NA" => "33.566,-93.758",  # https://www.reddit.com/r/geography/comments/1edld62/where_is_the_population_center_of_canada_us_and/lf85xrz/
  "SA" => "-15.4,-56.8",     # AI result based on weights from: https://en.wikipedia.org/wiki/List_of_South_American_metropolitan_areas_by_population
  "EU" => "48.9,13.1",       # AI result based on weights from  https://en.wikipedia.org/wiki/List_of_metropolitan_areas_in_Europe
  "AS" => "24.26,101.62",    # AI result based on weights from  https://en.wikipedia.org/wiki/List_of_metropolitan_areas_in_Asia
  "OC" => "-22.4,150.0",     # AI result
  "AF" => "5.3,21.5",        # AI result
  "AN" => "-77.846323,166.668235", # McMurdo Station
  # below here are stations 3000 km from another station to check for one F layer hop
  "NA2" => "48.566,-123.892",# 3000km from NA; Port Renfrew, BC, Canada
  "SA2" => "9.623,-66.9",    # 3000km from SA; Guárico, Venezuela
  "EU2" => "58.692,56.653",  # 3000km from EU; Perm Krai, Russia
  "AS2" => "32.857,130.826", # 3000km from AS; Kikuyo, Kikuchi District, Kumamoto, Japan
  "OC2" => "-33.82,122.177", # 3000km from OC; Merivale WA 6450, Australia
  "AF2" => "-20.323,30.0",   # 3000km from AF; Zvishavane, Zimbabwe
  "AN2" => "-71.576,-70.5",  # 3000km from AN; Alexander Island, Antarctica
);

# "bw" (bandwidth) defaults to 3000 for SSB
# "snrr" (SNR required) defaults to 6 for SSB
my %mode_to_params = (
  "SSB" => {
    "bw" => 3000,
    "snrr" => 6
  },
  "FT8" => {
    "bw" => 50,
    "snrr" => -3
  },
  "CW" => {
    "bw" => 500,
    "snrr" => 0,
  }
);

my $locs = "";
foreach my $c (sort keys %loc_map) {
  $locs .= "&" if $locs ne "";
  $locs .= "loc=$loc_map{$c}";
}
#print $locs, "\n";

my $params = "";
foreach my $k (keys %{$mode_to_params{$mode}}) {
  my $v = $mode_to_params{$mode}{$k};
  $params .= "&" if $params ne "";
  $params .= "$k=$v";
}
#print $params, "\n";

# txgos/rxgos = "gain offset" relative to isotropic.
# So +2.16 dBi = 0 dBd (dipole with optimal azimuth).
my $continental_url = "https://prop.kc2g.com/hfprop/bestband.json?txpow=100&txgos=2.16&rxgos=2.16&hours_ahead=0&$locs&$params";
#print "$continental_url\n";

# TODO FIXME: cache it
# Alternative: rate limit

open(HTTP, '-|', "curl --stderr - --max-time 10 -s -k -L '$continental_url'");
local $/;   # read entire file -- FIXME: potentially memory hungry
my $json = <HTTP>;
close(HTTP);
#print "$json\n";
if (not $json =~ /^\s*{/) {
  print "error while retrieving data: $json\n";
  exit $exitnonzeroonerror;
}
#print $json, "\n";
my $j = decode_json($json);

my %json_continent_to_index_map;
for(my $i = 0; $i < scalar @{$j->{locations}}; $i++) {
  my $loc = $j->{locations}[$i]{loc};
  foreach my $c (keys %loc_map) {
    if ($loc_map{$c} eq $loc) {
      $json_continent_to_index_map{$c} = $i;
    }
  }
}

print "to→│ NA │ SA │ EU │ AS │ OC │ AF │ AN │ ($mode)\n";
print "fm↓╞════╪════╪════╪════╪════╪════╪════╡\n";

foreach my $c ("NA", "SA", "EU", "AS", "OC", "AF", "AN") {
  print("$c │");
  my $ci = $json_continent_to_index_map{$c};
  foreach my $d ("NA", "SA", "EU", "AS", "OC", "AF", "AN") {
    my ($val, $bcr, $ind) = (undef, undef, undef);
    my $di = $json_continent_to_index_map{$d};
    if ($c eq $d) {
      # NA->NA would be zero distance;
      # instead we do NA->NA2, which is 3000km distance (1 F-layer hop).
      $di = $json_continent_to_index_map{"${d}2"};
    }
    if (not defined $j->{best}[$ci][$di]) {
      print grey(" xx ");
    } else {
      $val = $j->{best}[$ci][$di]{band};
      $bcr = $j->{best}[$ci][$di]{bcr};
      if ($bcr >= 70.0) {
        $ind = "+";
        print green("$ind$val");
      } elsif ($bcr < 70.0 and $bcr > 30.0) {
        $ind = " ";
        print yellow("$ind$val");
      } elsif ($bcr <= 30.0) {
        $ind = "-";
        print red("$ind$val");
      }
    }
    print "│";
  }
  print "\n";
}

